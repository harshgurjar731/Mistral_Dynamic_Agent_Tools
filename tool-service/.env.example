# ─────────────────────────────────────────────────────────────
# Mistral AI Configuration
# ─────────────────────────────────────────────────────────────
# Get your API key at https://console.mistral.ai/
MISTRAL_API_KEY=your_mistral_api_key_here

# Models are chosen per job in app/llm/routes.py (mistral-medium-2604 with
# reasoning for code generation, repair and arbitration; mistral-large-2512 as
# fallback). Override any role, e.g.:
# ROUTE_CODEGEN_MODEL=mistral-large-2512
# ROUTE_CODEGEN_EFFORT=none            # high | none | omit
# GET /models shows the effective routing.

# ── Synthesis pipeline ──
# TOOL_SYNTHESIS_MAX_ATTEMPTS=4        # generate/repair passes per job
# SYNTHESIS_WALL_CLOCK_SECONDS=900     # hard budget per job
# SYNTHESIS_WORKERS=3                  # concurrent jobs
# STRICT_ACTIVITY_SPEC=true            # activities need output_schema + worked examples
# ORACLE_ARBITRATION=true              # reference implementation settles code-vs-example disputes
# ORACLE_AUTOCORRECT=true              # ...and corrects a wrong example when code and reference agree
# TOOL_RUNTIME_FALLBACK=false          # labelled LLM answer when an agent tool fails (never activities)
# SECRETS_ALLOWLIST=                   # env vars tools may receive via _secrets, comma-separated

# ─────────────────────────────────────────────────────────────
# Dynamic Tool Settings
# ─────────────────────────────────────────────────────────────
# Automatically persist synthesised tools without manual review.
# Set to false in production / shared environments.
AUTO_APPROVE_DYNAMIC_TOOLS=false

# ─────────────────────────────────────────────────────────────
# Database (inside container)
# ─────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./tool_service.db

# ─────────────────────────────────────────────────────────────
# MCP Server Configuration (future / optional)
# ─────────────────────────────────────────────────────────────
# MCP_SERVERS_ENABLED=false
# MCP_REGISTRY_PATH=mcp_servers/mcp_registry.json
