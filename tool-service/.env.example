# ─────────────────────────────────────────────────────────────
# Mistral AI Configuration
# ─────────────────────────────────────────────────────────────
# Get your API key at https://console.mistral.ai/
MISTRAL_API_KEY=your_mistral_api_key_here

# Model used to synthesise new tool code
MISTRAL_CODING_MODEL=codestral-latest

# ─────────────────────────────────────────────────────────────
# Dynamic Tool Settings
# ─────────────────────────────────────────────────────────────
# Automatically persist synthesised tools without manual review.
# Set to false in production / shared environments.
AUTO_APPROVE_DYNAMIC_TOOLS=false

# ─────────────────────────────────────────────────────────────
# Database (inside container)
# ─────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./tool_service.db

# ─────────────────────────────────────────────────────────────
# MCP Server Configuration (future / optional)
# ─────────────────────────────────────────────────────────────
# MCP_SERVERS_ENABLED=false
# MCP_REGISTRY_PATH=mcp_servers/mcp_registry.json
