# ─────────────────────────────────────────────────────────────
# Mistral AI Configuration
# ─────────────────────────────────────────────────────────────
# Get your API key at https://console.mistral.ai/
# This is the platform key: the Default workspace (which owns everything made
# before workspaces existed) and background work use it. Other workspaces bring
# their own key, added in the admin console (/admin/workspaces).
MISTRAL_API_KEY=your_mistral_api_key_here

# ─────────────────────────────────────────────────────────────
# Accounts, workspaces and roles (app/auth)
# ─────────────────────────────────────────────────────────────
# Read from the environment only — never from the Settings page.
#
# The first platform admin, created on the first start when no admin exists.
# They must choose a new password at their first sign-in (/admin/login), after
# which this password no longer works; you can then remove it from here.
# Locked out later?  python -m app.auth.cli create-admin --email you@example.com
ADMIN_EMAIL=
ADMIN_INITIAL_PASSWORD=
# ADMIN_NAME=Platform admin
#
# Session cookies: Secure when the request arrived over HTTPS (auto), or force it.
# AUTH_COOKIE_SECURE=auto
# AUTH_SESSION_IDLE_MINUTES=720      # user sessions end after this long idle
# AUTH_SESSION_MAX_HOURS=168         # …and after this long in any case
# AUTH_ADMIN_IDLE_MINUTES=30
# AUTH_ADMIN_MAX_HOURS=12
# Sign-in protection
# AUTH_MAX_FAILED_LOGINS=5           # then the account locks for…
# AUTH_LOCKOUT_MINUTES=15
# AUTH_IP_ATTEMPTS=30                # sign-in attempts per address per 5 minutes
# Invite and reset links
# AUTH_INVITE_DAYS=7
# AUTH_RESET_HOURS=24
# Take the client address from X-Forwarded-For (behind Caddy or the Vite proxy).
# AUTH_TRUST_PROXY=true

# Models to use (defaults shown). Every value in this file can also be changed
# on the Settings page (/settings), which wins over .env and lists where each
# value is used. "Reset to default" there falls back to this file.
MISTRAL_ORCHESTRATOR_MODEL=mistral-large-4
MISTRAL_CODING_MODEL=codestral-latest
# DEFAULT_AGENT_MODEL=mistral-large-latest
# CHAT_DEFAULT_MODEL=mistral-large-latest
# AGENT_MODEL_LARGE=mistral-large-latest
# AGENT_MODEL_MEDIUM=mistral-medium-latest
# AGENT_MODEL_SMALL=mistral-small-latest
# AGENT_MODEL_CHOICES=mistral-large-latest,mistral-medium-latest,mistral-small-latest,codestral-latest

# The model list is read from Mistral's /v1/models (0 = only on demand).
# MODEL_CATALOG_REFRESH_HOURS=24
# AUTO_UPGRADE_DEPRECATED_MODELS=false

# ─────────────────────────────────────────────────────────────
# Dynamic Tool Settings
# ─────────────────────────────────────────────────────────────
# Set to false to require manual approval before a synthesized
# tool is persisted to the Tool Service
AUTO_APPROVE_DYNAMIC_TOOLS=true

# ─────────────────────────────────────────────────────────────
# Docker Tool Service
# ─────────────────────────────────────────────────────────────
# URL where the Tool Service container is reachable
TOOL_SERVICE_URL=http://localhost:9000

# ─────────────────────────────────────────────────────────────
# CORS
# ─────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins. Sign-in uses cookies, so list real
# origins: "*" is never trusted for requests that change something.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ─────────────────────────────────────────────────────────────
# API
# ─────────────────────────────────────────────────────────────
API_PREFIX=/api

# ─────────────────────────────────────────────────────────────
# Database
# ─────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./sql_app.db

# ─────────────────────────────────────────────────────────────
# Workflow Engine
# ─────────────────────────────────────────────────────────────
WORKFLOW_MAX_STEPS=20
WORKFLOW_STEP_TIMEOUT=60

# ─────────────────────────────────────────────────────────────
# Mistral Workflows Worker (Temporal-based cloud execution)
# ─────────────────────────────────────────────────────────────
# Set to false to use only the local DAG engine
# One worker process runs per workspace that has published workflows, on that
# workspace's key. The Default workspace polls DEPLOYMENT_NAME; every other
# workspace polls DEPLOYMENT_NAME-<first 8 characters of its id>. Each worker
# uses roughly 200-400 MB of memory.
MISTRAL_WORKER_ENABLED=false
# Threads for blocking work (Mistral SDK calls, database). Default: 8 per CPU, at least
# 32 — every concurrent model call holds one while it waits for Mistral.
# WORKER_THREADS=64
DEPLOYMENT_NAME=dynamic-workflows-worker
# Path to the directory containing compiled workflow modules
# (relative to the backend/ directory)
MISTRAL_WORKFLOWS_DIR=../mistral_workflows

# ─────────────────────────────────────────────────────────────
# Observability — traces of every action, sent to Mistral
# ─────────────────────────────────────────────────────────────
# Workflow runs, steps, rule verdicts (pass/fail), tool calls, pipeline layers,
# model calls and API actions are exported to Mistral Observability and shown
# on the Logs page. Uses MISTRAL_API_KEY; nothing else to set up.
OBSERVABILITY_ENABLED=true
OBSERVABILITY_ENVIRONMENT=development
# Mask secrets/PII in span attributes before export (Mistral SDK default policy).
OBSERVABILITY_REDACT=true

# ─────────────────────────────────────────────────────────────
# Vault — encrypted credentials for tools, activities and connectors
# ─────────────────────────────────────────────────────────────
# Fernet key(s) that encrypt vault values, newest first, comma separated.
# Empty: one is generated into backend/vault_key.secret (git-ignored) — fine
# for a laptop, but set this anywhere the filesystem is not permanent
# (containers), and back it up: losing every key loses every stored value.
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# To rotate: put a new key first, keep the old one after it, restart, then
# Settings → Vault → "Re-encrypt with the newest key", then drop the old key.
VAULT_MASTER_KEYS=
# When set, adding, changing, revealing and deleting vault entries needs this
# token (Settings → Vault → Unlock). Reading which entries exist does not.
VAULT_ADMIN_TOKEN=
# The rest (reveal, history, expiry, audit, build prerequisites) is on the
# Settings page; these are the defaults.
# VAULT_ENABLED=true
# VAULT_ALLOW_REVEAL=false
# PREREQ_CHECK_ENABLED=true
# PREREQ_UNATTENDED_POLICY=proceed
