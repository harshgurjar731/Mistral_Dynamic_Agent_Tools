# ─────────────────────────────────────────────────────────────
# Production settings for deploy/docker-compose.yml
# Copy to deploy/.env (git-ignored) and fill in the blanks.
# deploy/azure/deploy.sh does the copy, generates the secrets left empty below
# and replaces <vm-public-ip> with the VM's public IP.
# Local development keeps using backend/.env and tool-service/.env.
#
# This one file feeds the backend AND the tool-service containers.
# Most backend values can also be changed on the Settings page (/settings),
# which wins over this file; "Reset to default" there falls back to it.
# ─────────────────────────────────────────────────────────────

# ── Public address ───────────────────────────────────────────
# ":80" serves plain HTTP on the VM's public IP.
# A domain name (e.g. agents.example.com) turns on automatic HTTPS; then also
# set PUBLIC_URL / CORS_ORIGINS to https://<domain> and AUTH_COOKIE_SECURE=true.
SITE_ADDRESS=:80
# Full URL users open in the browser (used for document download links, CORS).
PUBLIC_URL=http://<vm-public-ip>
# Sign-in uses cookies, so list real origins: "*" is never trusted.
CORS_ORIGINS=http://<vm-public-ip>

# ── Mistral ──────────────────────────────────────────────────
# The platform key (the Default workspace, and background work). Other
# workspaces' keys are added in the admin console (/admin/workspaces) and
# stored encrypted with VAULT_MASTER_KEYS.
MISTRAL_API_KEY=

# ─────────────────────────────────────────────────────────────
# Accounts, workspaces and roles (app/auth)
# ─────────────────────────────────────────────────────────────
# Read from the environment only — never from the Settings page.
#
# The first platform admin, created on the first start when no admin exists.
# They must choose a new password at their first sign-in (/admin/login), after
# which this password no longer works; you can then remove it from here.
# Locked out later?
#   docker compose exec backend python -m app.auth.cli create-admin --email you@example.com
ADMIN_EMAIL=
ADMIN_INITIAL_PASSWORD=
# ADMIN_NAME=Platform admin
#
# Session cookies: Secure when the request arrived over HTTPS (auto), or force it.
# With a domain name in SITE_ADDRESS (HTTPS), set this to true.
# AUTH_COOKIE_SECURE=auto
# AUTH_SESSION_IDLE_MINUTES=720      # user sessions end after this long idle
# AUTH_SESSION_MAX_HOURS=168         # …and after this long in any case
# AUTH_ADMIN_IDLE_MINUTES=30
# AUTH_ADMIN_MAX_HOURS=12
# Sign-in protection
# AUTH_MAX_FAILED_LOGINS=5           # then the account locks for…
# AUTH_LOCKOUT_MINUTES=15
# AUTH_IP_ATTEMPTS=30                # sign-in attempts per address per 5 minutes
# Invite and reset links
# AUTH_INVITE_DAYS=7
# AUTH_RESET_HOURS=24
# Take the client address from X-Forwarded-For (Caddy sits in front).
# AUTH_TRUST_PROXY=true

# ─────────────────────────────────────────────────────────────
# Models (defaults shown)
# ─────────────────────────────────────────────────────────────
MISTRAL_ORCHESTRATOR_MODEL=mistral-medium-2604
# ORCHESTRATOR_REASONING_EFFORT=high
# ORCHESTRATOR_FALLBACK_MODEL=mistral-medium-2604
# MISTRAL_CODING_MODEL is retired: tool and activity code use the model routes
# on the Settings page (and ROUTE_* below for the tool service).
# DEFAULT_AGENT_MODEL=mistral-medium-latest
# An agent step whose own model has not answered after AGENT_HEDGE_SECONDS is
# also run on AGENT_FALLBACK_MODEL; "none" turns it off.
# AGENT_FALLBACK_MODEL=mistral-medium-latest
# AGENT_HEDGE_SECONDS=40
# AGENT_CALL_TIMEOUT_SECONDS=180
# AGENT_MODEL_HEALTH_CHECK=true
# CHAT_DEFAULT_MODEL=mistral-large-latest
# AGENT_MODEL_LARGE=mistral-large-latest
# AGENT_MODEL_MEDIUM=mistral-medium-latest
# AGENT_MODEL_SMALL=mistral-small-latest
# AGENT_MODEL_CHOICES=mistral-large-latest,mistral-medium-latest,mistral-small-latest,codestral-latest
# The model list is read from Mistral's /v1/models (0 = only on demand).
# MODEL_CATALOG_REFRESH_HOURS=24
# AUTO_UPGRADE_DEPRECATED_MODELS=false

# ─────────────────────────────────────────────────────────────
# Backend
# ─────────────────────────────────────────────────────────────
API_PREFIX=/api
# Persist synthesised tools without manual review (read by backend and tool service).
AUTO_APPROVE_DYNAMIC_TOOLS=true
# UPLOAD_MAX_MB=20
# Workflow engine
WORKFLOW_MAX_STEPS=20
WORKFLOW_STEP_TIMEOUT=60
# Threads for blocking work (Mistral SDK calls, database). Default: 8 per CPU,
# at least 32 — every concurrent model call holds one while it waits for Mistral.
# WORKER_THREADS=64

# ── Mistral Workflows worker (Temporal-based cloud execution) ─
# Must differ from the DEPLOYMENT_NAME in your local backend/.env: with the same
# Mistral API key, both workers would otherwise poll one queue and pick up each
# other's workflow runs.
DEPLOYMENT_NAME=azure-vm
# One worker process runs per workspace that has published workflows, on that
# workspace's key. The Default workspace polls DEPLOYMENT_NAME; every other
# workspace polls DEPLOYMENT_NAME-<first 8 characters of its id>. Each worker
# uses roughly 200-400 MB of memory.
MISTRAL_WORKER_ENABLED=true
MISTRAL_WORKFLOWS__WORKER__VERSIONING__ENABLED=true
MISTRAL_WORKFLOWS__WORKER__VERSIONING__AUTO_REGISTER_AS_CURRENT=true

# ── Image build options (read by docker compose at build time) ─
# Build the backend without the Temporal worker (then also set
# MISTRAL_WORKER_ENABLED=false).
WITH_MISTRAL_WORKFLOWS=true
# NVIDIA Brev CLI for Brev remote servers. Log in once after the first start:
#   docker compose exec backend brev login --token ...
WITH_BREV_CLI=true

# ── Observability — traces of every action, sent to Mistral ──
# Shown on the Logs page. Uses MISTRAL_API_KEY; nothing else to set up.
OBSERVABILITY_ENABLED=true
OBSERVABILITY_ENVIRONMENT=production
# Mask secrets/PII in span attributes before export.
OBSERVABILITY_REDACT=true

# ─────────────────────────────────────────────────────────────
# Secrets — back these up together with this file
# ─────────────────────────────────────────────────────────────
# Encrypts stored remote-server credentials. Generate once and keep it:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# (deploy/azure/deploy.sh fills this in automatically on first run.)
REMOTE_SERVER_SECRET_KEY=

# Encrypts the vault (Settings → Vault) and the workspaces' Mistral keys.
# Losing it makes every stored value unreadable. Rotation: put a new key first,
# comma, the old one; restart; Settings → Vault → "Re-encrypt with the newest
# key"; then drop the old key.
# (deploy/azure/deploy.sh fills this in automatically on first run.)
VAULT_MASTER_KEYS=
# Optional but recommended on a public VM: required to add, change, reveal or
# delete vault entries (Settings → Vault → Unlock).
VAULT_ADMIN_TOKEN=
# Defaults; the rest (history, expiry, audit) is on the Settings page.
# VAULT_ENABLED=true
# VAULT_ALLOW_REVEAL=false
# PREREQ_CHECK_ENABLED=true
# PREREQ_UNATTENDED_POLICY=proceed

# ─────────────────────────────────────────────────────────────
# Tool service (synthesis pipeline)
# ─────────────────────────────────────────────────────────────
# Models are chosen per job (mistral-medium-2604 with reasoning; mistral-large-2512
# as fallback). Override any role, e.g.:
# ROUTE_CODEGEN_MODEL=mistral-large-2512
# ROUTE_CODEGEN_EFFORT=none            # high | none | omit
# TOOL_SYNTHESIS_MAX_ATTEMPTS=4        # generate/repair passes per job
# SYNTHESIS_WALL_CLOCK_SECONDS=900     # hard budget per job
# SYNTHESIS_WORKERS=3                  # concurrent jobs
# STRICT_ACTIVITY_SPEC=true            # activities need output_schema + worked examples
# ORACLE_ARBITRATION=true
# ORACLE_AUTOCORRECT=true
# TOOL_RUNTIME_FALLBACK=false          # labelled LLM answer when an agent tool fails
# SECRETS_ALLOWLIST=                   # env vars tools may receive via _secrets, comma-separated

# ─────────────────────────────────────────────────────────────
# Knowledge graph (Neo4j)
# ─────────────────────────────────────────────────────────────
# Used for both the Neo4j container and the backend connection.
# deploy/azure/deploy.sh generates one on first run if left empty.
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
NEO4J_PAGECACHE=512M
NEO4J_HEAP_MAX=1G

# ─────────────────────────────────────────────────────────────
# Ports (change only if something else already uses them)
# ─────────────────────────────────────────────────────────────
HTTP_PORT=80
HTTPS_PORT=443
# Neo4j browser/Bolt, bound to the VM's loopback only (reach with an SSH tunnel).
# NEO4J_HTTP_PORT=7474
# NEO4J_BOLT_PORT=7687

# Set by docker-compose.yml for the containers; do not set here:
# TOOL_SERVICE_URL, NEO4J_URI, NEO4J_USER, DATABASE_URL, MISTRAL_WORKFLOWS_DIR,
# PUBLIC_DOCUMENTS_BASE_URL
