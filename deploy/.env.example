# ─────────────────────────────────────────────────────────────
# Production settings for deploy/docker-compose.yml
# Copy to deploy/.env (git-ignored) and fill in the blanks.
# Local development keeps using backend/.env and tool-service/.env.
# ─────────────────────────────────────────────────────────────

# ── Public address ───────────────────────────────────────────
# ":80" serves plain HTTP on the VM's public IP.
# A domain name (e.g. agents.example.com) turns on automatic HTTPS.
SITE_ADDRESS=:80
# Full URL users open in the browser (used for document download links, CORS).
PUBLIC_URL=http://52.233.82.192
CORS_ORIGINS=http://52.233.82.192

# ── Mistral ──────────────────────────────────────────────────
# The platform key (the Default workspace). Other workspaces' keys are added in
# the admin console and stored encrypted with VAULT_MASTER_KEYS.
MISTRAL_API_KEY=

# ─────────────────────────────────────────────────────────────
# Accounts, workspaces and roles (app/auth)
# ─────────────────────────────────────────────────────────────
# Read from the environment only — never from the Settings page.
#
# The first platform admin, created on the first start when no admin exists.
# They must choose a new password at their first sign-in (/admin/login), after
# which this password no longer works; you can then remove it from here.
# Locked out later?  python -m app.auth.cli create-admin --email you@example.com
ADMIN_EMAIL=
ADMIN_INITIAL_PASSWORD=
# ADMIN_NAME=Platform admin
#
# Session cookies: Secure when the request arrived over HTTPS (auto), or force it.
# With a domain name in SITE_ADDRESS (HTTPS), set this to true.
# AUTH_COOKIE_SECURE=auto
# AUTH_SESSION_IDLE_MINUTES=720      # user sessions end after this long idle
# AUTH_SESSION_MAX_HOURS=168         # …and after this long in any case
# AUTH_ADMIN_IDLE_MINUTES=30
# AUTH_ADMIN_MAX_HOURS=12
# Sign-in protection
# AUTH_MAX_FAILED_LOGINS=5           # then the account locks for…
# AUTH_LOCKOUT_MINUTES=15
# AUTH_IP_ATTEMPTS=30                # sign-in attempts per address per 5 minutes
# Invite and reset links
# AUTH_INVITE_DAYS=7
# AUTH_RESET_HOURS=24
# Take the client address from X-Forwarded-For (behind Caddy or the Vite proxy).
# AUTH_TRUST_PROXY=true
MISTRAL_ORCHESTRATOR_MODEL=mistral-large-4
MISTRAL_CODING_MODEL=codestral-latest

# ── Backend ──────────────────────────────────────────────────
API_PREFIX=/api
AUTO_APPROVE_DYNAMIC_TOOLS=true
# Must differ from the DEPLOYMENT_NAME in your local backend/.env: with the same
# Mistral API key, both workers would otherwise poll one queue and pick up each
# other's workflow runs.
DEPLOYMENT_NAME=azure-vm
MISTRAL_WORKER_ENABLED=true
MISTRAL_WORKFLOWS__WORKER__VERSIONING__ENABLED=true
MISTRAL_WORKFLOWS__WORKER__VERSIONING__AUTO_REGISTER_AS_CURRENT=true
# Build the backend image without the Temporal worker (then also set
# MISTRAL_WORKER_ENABLED=false).
WITH_MISTRAL_WORKFLOWS=true

# Encrypts stored remote-server credentials. Generate once and keep it:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# (deploy/azure/deploy.sh fills this in automatically on first run.)
REMOTE_SERVER_SECRET_KEY=

# Encrypts the vault (Settings → Vault): the API keys and service URLs your
# tools and activities use. Same kind of key; keep it, and back it up — losing
# it makes every stored value unreadable. Rotation: put a new key first,
# comma, the old one; restart; re-encrypt on Settings → Vault.
# (deploy/azure/deploy.sh fills this in automatically on first run.)
VAULT_MASTER_KEYS=
# Optional: required to add, change, reveal or delete vault entries.
VAULT_ADMIN_TOKEN=

# ── Knowledge graph (Neo4j) ──────────────────────────────────
# Used for both the Neo4j container and the backend connection.
# deploy/azure/deploy.sh generates one on first run if left empty.
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
NEO4J_PAGECACHE=512M
NEO4J_HEAP_MAX=1G

# ── Ports (change only if something else already uses them) ─
HTTP_PORT=80
HTTPS_PORT=443
